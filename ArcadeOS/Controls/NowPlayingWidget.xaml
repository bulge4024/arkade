<UserControl x:Class="ArcadeOS.Controls.NowPlayingWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsHitTestVisible="False" Focusable="False" Width="222" Height="52">
 <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></UserControl.Style>
 <Border Background="#F2101722" CornerRadius="8" BorderBrush="#645437" BorderThickness="1" Padding="8,6">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="CassetteArt" Width="40" Height="28" VerticalAlignment="Center">
    <Border Background="#29343D" BorderBrush="#EAC574" BorderThickness="1.5" CornerRadius="3"/>
    <Border Background="#13232A" BorderBrush="#76D6BA" BorderThickness=".7" CornerRadius="5" Margin="5,6,5,8"/>
    <Grid x:Name="LeftReel" Width="11" Height="11" HorizontalAlignment="Left" Margin="7,0,0,2" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><RotateTransform/></Grid.RenderTransform><Ellipse Stroke="#EAC574" StrokeThickness="1"/><Path Data="M5.5,1 L5.5,10 M1,5.5 L10,5.5" Stroke="#EAC574" StrokeThickness="1"/></Grid>
    <Grid x:Name="RightReel" Width="11" Height="11" HorizontalAlignment="Right" Margin="0,0,7,2" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><RotateTransform/></Grid.RenderTransform><Ellipse Stroke="#EAC574" StrokeThickness="1"/><Path Data="M5.5,1 L5.5,10 M1,5.5 L10,5.5" Stroke="#EAC574" StrokeThickness="1"/></Grid>
    <Path Data="M11,27 L14,21 26,21 29,27" Stroke="#EAC574" StrokeThickness="1"/>
   </Grid>
   <Grid x:Name="RecordArt" Width="32" Height="32" Visibility="Collapsed" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><RotateTransform/></Grid.RenderTransform><Ellipse Fill="#11151C" Stroke="#EAC574" StrokeThickness="1"/><Ellipse Margin="4" Stroke="#40525B"/><Ellipse Margin="7" Stroke="#40525B"/><Ellipse Margin="11" Fill="#76D6BA"/><Ellipse Margin="14" Fill="#11151C"/><Path Data="M16,2 L19,8" Stroke="#EAC574" StrokeThickness="1.5"/></Grid>
   <TextBlock x:Name="NotesArt" Text="♪ ♫" FontSize="25" Foreground="#76D6BA" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="3"/></Grid.RowDefinitions>
    <Grid x:Name="TitleViewport" ClipToBounds="True"><TextBlock x:Name="SongTitle" Text="{Binding TrackName}" FontSize="11" Foreground="#F5F1E8" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock></Grid>
    <TextBlock Grid.Row="1" Text="{Binding ProgressText}" Foreground="#A8B4C4" FontSize="8" Margin="0,0,0,2"/>
    <ProgressBar Grid.Row="2" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Foreground="#EAC574" Background="#303A49" BorderThickness="0"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
