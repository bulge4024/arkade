<Window x:Class="ArcadeOS.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ArcadeOS.Controls"
 Title="Arkade" Width="760" Height="1020" MinWidth="480" MinHeight="700" WindowStartupLocation="CenterScreen"
 Background="#090D15" Foreground="#F5F1E8" FontFamily="Segoe UI" PreviewKeyDown="OnKeyDown">
 <Window.Resources>
  <DrawingImage x:Key="RecentArtwork">
   <DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L280,0 280,166 0,166 Z"/>
    <GeometryDrawing Brush="#102C32"><GeometryDrawing.Geometry><EllipseGeometry Center="140,77" RadiusX="64" RadiusY="64"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#304B4C" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><EllipseGeometry Center="140,77" RadiusX="71" RadiusY="71"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Geometry="M92,49 A55,55 0 1 1 94,113"><GeometryDrawing.Pen><Pen Brush="#EAC574" Thickness="5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
    <GeometryDrawing Brush="#EAC574" Geometry="M80,36 L106,47 84,62 Z"/>
    <GeometryDrawing Geometry="M140,37 L140,75 161,87"><GeometryDrawing.Pen><Pen Brush="#76D6BA" Thickness="5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
    <GeometryDrawing Brush="#172637" Geometry="M105,96 L175,96 Q189,96 195,111 L202,135 Q204,149 192,149 Q183,149 174,136 L106,136 Q97,149 88,149 Q76,149 78,135 L85,111 Q91,96 105,96 Z"><GeometryDrawing.Pen><Pen Brush="#EAC574" Thickness="3"/></GeometryDrawing.Pen></GeometryDrawing>
    <GeometryDrawing Geometry="M105,107 L105,127 M95,117 L115,117"><GeometryDrawing.Pen><Pen Brush="#76D6BA" Thickness="5" StartLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
    <GeometryDrawing Brush="#EAC574"><GeometryDrawing.Geometry><EllipseGeometry Center="174,112" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Brush="#76D6BA"><GeometryDrawing.Geometry><EllipseGeometry Center="164,123" RadiusX="4" RadiusY="4"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Geometry="M22,96 L57,96 M223,96 L258,96 M37,111 L62,111 M218,111 L243,111"><GeometryDrawing.Pen><Pen Brush="#426064" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing>
    <GeometryDrawing Brush="#EAC574" Geometry="M238,29 L241,37 249,40 241,43 238,51 235,43 227,40 235,37 Z"/>
    <GeometryDrawing Brush="#76D6BA"><GeometryDrawing.Geometry><EllipseGeometry Center="46,58" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
   </DrawingGroup></DrawingImage.Drawing>
  </DrawingImage>

  <DataTemplate x:Key="UpdateStatusTemplate">
   <Grid>
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsUpdating}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <TextBlock Text="{Binding UpdateMessage}" Foreground="#EAC574" FontSize="11" TextTrimming="CharacterEllipsis" Margin="3,0,3,7"/>
    <ProgressBar Height="2" VerticalAlignment="Bottom" IsIndeterminate="{Binding IsUpdating}" Foreground="#EAC574" Background="#253044" BorderThickness="0"/>
   </Grid>
  </DataTemplate>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DDD8CC"/><Setter Property="Background" Value="#202735"/>
   <Setter Property="BorderBrush" Value="#364052"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonFrame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#FFE4A3"/><Setter TargetName="ButtonFrame" Property="Effect"><Setter.Value><DropShadowEffect Color="#EAC574" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/></Setter.Value></Setter></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#EAC574"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem" x:Key="CoverItem">
   <Setter Property="Foreground" Value="#F5F1E8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Frame" Background="#151E2B" BorderBrush="#303A49" BorderThickness="2" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
     <Border.RenderTransform><ScaleTransform/></Border.RenderTransform><ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
     <Setter TargetName="Frame" Property="BorderBrush" Value="#EAC574"/>
     <Setter TargetName="Frame" Property="Effect"><Setter.Value><DropShadowEffect Color="#EAC574" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/></Setter.Value></Setter>
     <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
    </Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MusicHeaderStatus" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding IsVisible, ElementName=NowPlayingDisplay}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="SystemHome" Margin="22,16">
   <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel VerticalAlignment="Center"><Image Source="Assets/Arkade-logo.png" Width="190" Height="56" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Arkade logo"/><TextBlock Text="THE CABINET COLLECTION" Foreground="#EAC574" FontSize="9" Margin="1,4,0,0"/></StackPanel><TextBlock Style="{StaticResource MusicHeaderStatus}" Text="{Binding SystemCount}" Foreground="#A8B4C4" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
   <StackPanel Grid.Row="1" Margin="4,24,0,22"><TextBlock Text="CHOOSE YOUR SYSTEM" FontSize="28" FontWeight="Black"/><TextBlock Text="A world of games. One cabinet." FontSize="13" Foreground="#A8B4C4" Margin="0,7,0,0"/></StackPanel>
   <ListBox x:Name="SystemGrid" Grid.Row="2" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" ItemContainerStyle="{StaticResource CoverItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False" SelectionChanged="OnSystemSelectionChanged" MouseDoubleClick="OpenSystem" AutomationProperties.Name="Choose gaming system">
    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate>
     <Grid Height="{Binding SystemCardHeight, RelativeSource={RelativeSource AncestorType=Window}}" ClipToBounds="True">
      <Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#131D2C"/><GradientStop Color="#263144" Offset="1"/></LinearGradientBrush></Grid.Background>
      <Image Source="{Binding ArtworkPath}" Stretch="UniformToFill" Opacity="0.10"/>
      <Image Stretch="Uniform" Height="{Binding SystemConsoleImageHeight, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,24,16,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{Binding ConsoleImagePath}"/><Style.Triggers><DataTrigger Binding="{Binding Name}" Value="Last played"><Setter Property="Source" Value="{StaticResource RecentArtwork}"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
      <Grid Margin="17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="{Binding CountLabel}" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="10"/>
       <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,14"><TextBlock Text="{Binding Name}" FontSize="25" FontWeight="Black" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="#C5CDD9" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
       <TextBlock Grid.Row="2" Text="{Binding OpenLabel}" Foreground="{Binding Accent}" FontSize="9" FontWeight="SemiBold"/>
      </Grid>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="3" Margin="0,16,0,0"><ContentControl Height="28" Margin="0,0,0,8" Content="{Binding}" ContentTemplate="{StaticResource UpdateStatusTemplate}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="OpenSystemButton" Content="SELECT  /  OPEN SYSTEM" Click="OpenSystem" Background="#EAC574" Foreground="#17150F" Margin="0,0,8,0"/>
    <Button x:Name="HomeHelpButton" Grid.Column="1" Content="HELP" Click="ShowHelp" Margin="0,0,8,0"/>
    <Button x:Name="HomeSettingsButton" Grid.Column="2" Content="SETTINGS" Click="ShowSettings" Margin="0,0,8,0"/>
    <Button x:Name="HomePowerButton" Grid.Column="3" Content="⏻ POWER" Click="ShowPower"/>
   </Grid><TextBlock Text="JOYSTICK  CHOOSE SYSTEM     SELECT  OPEN     MENU  HELP / SETTINGS / POWER" Foreground="#A8B4C4" FontSize="10" TextWrapping="Wrap" Margin="3,12,0,0"/></StackPanel>
  </Grid>
  <Grid x:Name="LibrarySurface" Margin="22,16" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="0"/><RowDefinition x:Name="FeaturedRow" Height="240"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Content="←  SYSTEMS" Click="ShowSystemHomeClick" Padding="10,10" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <Image x:Name="HeaderConsoleImage" Grid.Column="1" Width="52" Height="44" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="Selected console">
     <Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{Binding SelectedSystem.ConsoleImagePath}"/><Style.Triggers>
      <DataTrigger Binding="{Binding SelectedSystem.ConsoleImagePath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding SelectedSystem.Name}" Value="Last played"><Setter Property="Source" Value="{StaticResource RecentArtwork}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     </Style.Triggers></Style></Image.Style>
    </Image>
    <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="18" FontWeight="Black" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
    <Grid Grid.Column="3" Width="{Binding Width, ElementName=NowPlayingDisplay}">
     <StackPanel Style="{StaticResource MusicHeaderStatus}" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding LibrarySource}" Foreground="#B6B4AF" FontSize="9" HorizontalAlignment="Right"/><TextBlock Text="●  READY TO PLAY" Foreground="#78CAB7" FontSize="8" Margin="0,5,0,0" HorizontalAlignment="Right"/></StackPanel>
    </Grid>
   </Grid>
   <ListBox x:Name="CategoryPicker" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Platforms">
    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <Setter Property="Foreground" Value="#BCBFCA"/><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,3,8,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="TabFrame" CornerRadius="7" Background="#192332" BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="#EAC574"/><Setter Property="Foreground" Value="#1B1810"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabFrame" Property="BorderBrush" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
   </ListBox>
   <TextBlock x:Name="EmptyLibraryMessage" Grid.Row="4" Text="No games in this system yet.&#10;&#10;Add ROMs to its configured folder. New games appear automatically within 30 seconds while browsing.&#10;&#10;Press Back to choose another system." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="#A8B4C4" FontSize="16" Margin="24" Visibility="Collapsed" IsHitTestVisible="False"/>
   <Border Grid.Row="2" CornerRadius="14" BorderThickness="1" BorderBrush="#645437" ClipToBounds="True">
    <Grid>
    <Grid x:Name="FeaturedPanel" DataContext="{Binding SelectedGame}">
     <Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#101824"/><GradientStop Color="#3D392B" Offset="1"/></LinearGradientBrush></Grid.Background>
     <Image Source="{Binding BackgroundArtworkPath}" Stretch="UniformToFill" Opacity="0.32"/>
     <MediaElement x:Name="GamePreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Volume="0" ScrubbingEnabled="False" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" Focusable="False" MediaOpened="OnGamePreviewOpened" MediaEnded="OnGamePreviewEnded" MediaFailed="OnGamePreviewFailed"/>
     <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#E6090D15"/><GradientStop Color="#A6090D15" Offset="0.55"/><GradientStop Color="#59090D15" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Grid Margin="20,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.44*"/></Grid.ColumnDefinitions>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel VerticalAlignment="Center" Margin="0,0,12,6">
        <TextBlock Text="SELECTED GAME" FontSize="9" FontWeight="Bold" Foreground="#EAC574"/>
        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Black" TextWrapping="Wrap" MaxHeight="82" TextTrimming="CharacterEllipsis" Margin="0,9,0,5"/>
        <TextBlock Text="{Binding Tagline}" FontSize="10" Foreground="#BFC5CE" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding MetadataLine}" FontSize="11" Foreground="#EAC574" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <StackPanel Grid.Row="1" Orientation="Horizontal">
        <Button x:Name="HeroPlayButton" Content="▶  PLAY" Click="LaunchGame" IsEnabled="{Binding CanLaunch}" Background="#EAC574" Foreground="#19170F" BorderBrush="#EAC574" Margin="0,0,8,0"/>
        <Button x:Name="HeroDetailsButton" Content="DETAILS" Click="ShowDetails"/>
       </StackPanel>
      </Grid>
      <Border Grid.Column="1" Background="#B0090D15" CornerRadius="8" Margin="8,0,0,0" Padding="6">
       <Grid><TextBlock Text="{Binding Symbol}" FontSize="60" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ArtworkPath}" Stretch="Uniform"/></Grid>
      </Border>
     </Grid>
    </Grid>
    <StackPanel x:Name="EmptySystemHero" Background="#17202D" Visibility="Collapsed" Margin="16" VerticalAlignment="Center">
     <TextBlock Text="{Binding Category}" FontSize="28" FontWeight="Black" Foreground="#EAC574"/>
     <TextBlock Text="Your next collection starts here." FontSize="14" Foreground="#A8B4C4" Margin="0,10,0,0"/>
    </StackPanel>
    </Grid>
   </Border>
   <DockPanel Grid.Row="3" Margin="4,12,4,4"><TextBlock Text="YOUR COLLECTION" FontSize="12" FontWeight="Bold"/><TextBlock Text="{Binding LibraryCount}" FontSize="9" Foreground="#9DA7B8" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   <Grid Grid.Row="4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101722" CornerRadius="9" Margin="0,6,6,6" BorderThickness="1">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#303A49"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ConsoleRail}" Value="True"><Setter Property="BorderBrush" Value="#EAC574"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="SYSTEMS" Foreground="#A8B4C4" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,9,0,5"/>
      <ListBox x:Name="ConsoleRail" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem, Mode=TwoWay}" SelectionChanged="OnConsoleRailSelectionChanged" Background="Transparent" BorderThickness="0" Padding="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.Name="Switch console">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#A8B4C4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ConsoleFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="4,7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ConsoleFrame" Property="Background" Value="#302B20"/><Setter TargetName="ConsoleFrame" Property="BorderBrush" Value="#EAC574"/><Setter Property="Foreground" Value="#FFE4A3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ConsoleFrame" Property="BorderBrush" Value="#EAC574"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
       </Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel>
        <Image Height="32" Stretch="Uniform" Margin="0,0,0,4"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{Binding ConsoleImagePath}"/><Style.Triggers><DataTrigger Binding="{Binding ConsoleImagePath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Name}" Value="Last played"><Setter Property="Source" Value="{StaticResource RecentArtwork}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding CountLabel}" FontSize="8" Foreground="#8996A8" TextAlignment="Center" Margin="0,3,0,0"/>
       </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="#101722" CornerRadius="9" Margin="0,6,6,6" BorderThickness="1">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#303A49"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AlphabetRail}" Value="True"><Setter Property="BorderBrush" Value="#EAC574"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <ListBox x:Name="AlphabetRail" ItemsSource="{Binding Letters}" SelectedItem="{Binding SelectedLetter, Mode=TwoWay}" SelectionChanged="OnAlphabetSelectionChanged" Background="Transparent" BorderThickness="0" Padding="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.Name="Jump to game letter">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
       <Setter Property="Foreground" Value="#A8B4C4"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Height" Value="29"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="LetterFrame" CornerRadius="5" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="LetterFrame" Property="Background" Value="#EAC574"/><Setter Property="Foreground" Value="#17150F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
     </ListBox>
    </Border>
   <ListBox x:Name="GameGrid" Grid.Column="2" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" ItemContainerStyle="{StaticResource CoverItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="ShowDetails" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Game covers">
    <ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingTilePanel Columns="4" ItemHeight="{Binding CoverCardHeight, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate>
     <Grid Height="{Binding CoverCardHeight, RelativeSource={RelativeSource AncestorType=Window}}">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="47"/></Grid.RowDefinitions>
      <Border Background="#101722" Margin="4" CornerRadius="6" ClipToBounds="True">
       <Grid><Ellipse Width="100" Height="100" Stroke="{Binding Accent}" Opacity="0.2"/><TextBlock Text="{Binding Symbol}" Foreground="{Binding Accent}" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ArtworkPath}" Stretch="Uniform"/></Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="8,3,6,0"><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Platform}" FontSize="9" Foreground="#96A1B3" Margin="0,4,0,0"/></StackPanel>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   </Grid>
   <StackPanel Grid.Row="5" Margin="0,12,0,0">
    <ContentControl Height="28" Margin="0,0,0,8" Content="{Binding}" ContentTemplate="{StaticResource UpdateStatusTemplate}"/>
    <Border Background="#172131" CornerRadius="10" BorderBrush="#3B4658" BorderThickness="1" Padding="7">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="FooterPlayButton" Click="LaunchGame" IsEnabled="{Binding SelectedGame.CanLaunch}" Background="#EAC574" Foreground="#17150F" BorderBrush="#EAC574" HorizontalContentAlignment="Left" Padding="12,7" Margin="0,0,7,0">
       <StackPanel><TextBlock Text="①  PRESS START" FontWeight="Bold" FontSize="11"/><TextBlock Text="{Binding SelectedGame.Title}" FontSize="10" MaxWidth="180" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel>
      </Button>
      <Button x:Name="HelpButton" Grid.Column="1" Content="?  HELP" Click="ShowHelp" Margin="0,0,7,0" Padding="12,10"/>
      <Button x:Name="SettingsButton" Grid.Column="2" Content="SETTINGS" Click="ShowSettings" Padding="12,10"/>
     </Grid>
    </Border>
    <TextBlock Text="{Binding Status}" Foreground="#A8B4C4" FontSize="10" Margin="3,8,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
  <Border x:Name="DetailsOverlay" Background="#FA101722" BorderBrush="#EAC574" BorderThickness="1" CornerRadius="15" Margin="22,16" Padding="24" Visibility="Collapsed">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Hidden">
     <StackPanel DataContext="{Binding SelectedGame}">
      <TextBlock Text="GAME DETAILS" Foreground="#EAC574" FontSize="10" FontWeight="Bold"/>
      <Image Source="{Binding ArtworkPath}" Height="210" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,20,0,18"/>
      <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Black" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Tagline}" Foreground="#AAB7C9" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding MetadataLine}" Foreground="#EAC574" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Players}" Foreground="#C2CAD6" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding Credits}" Foreground="#C2CAD6" Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="16" LineHeight="26" Margin="0,22,0,20"/>
      <TextBlock Text="{Binding Availability}" Foreground="#AAB7C9" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Margin="0,15,0,0">
     <TextBlock Text="{Binding LaunchMessage}" Foreground="#EAC574" Margin="0,0,0,14" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal"><Button x:Name="LaunchButton" Content="▶  PLAY" Click="LaunchGame" IsEnabled="{Binding SelectedGame.CanLaunch}" Background="#EAC574" Foreground="#19170F" Margin="0,0,12,0"/><Button x:Name="CloseDetailsButton" Content="BACK TO LIBRARY" Click="CloseDetails"/></StackPanel>
    </StackPanel>
   </Grid>
  </Border>
  <Border x:Name="UtilityOverlay" Background="#FC101722" BorderBrush="#EAC574" BorderThickness="1" CornerRadius="15" Margin="22,16" Padding="28" Visibility="Collapsed">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="UtilityTitle" Foreground="#EAC574" FontSize="28" FontWeight="Black"/><TextBlock x:Name="UtilityText" TextWrapping="Wrap" FontSize="16" LineHeight="28" Margin="0,24,0,24"/><Button x:Name="FullscreenButton" Content="TOGGLE FULLSCREEN" Click="ToggleFullscreenClick" HorizontalAlignment="Left"/><Button x:Name="RefreshLibraryButton" Content="REFRESH LIBRARY" Click="RefreshLibraryClick" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     <StackPanel x:Name="UpdateSettingsPanel" Margin="0,16,0,4" Visibility="Collapsed">
      <Button x:Name="CheckUpdatesButton" Content="CHECK FOR UPDATES" Click="CheckUpdatesClick" HorizontalAlignment="Left"/>
      <TextBlock x:Name="UpdateSettingsStatus" Foreground="#A8B4C4" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel x:Name="WindowsStartupPanel" Margin="0,12,0,0" Visibility="Collapsed">
      <Button x:Name="WindowsStartupButton" Content="START WITH WINDOWS: OFF" Click="WindowsStartupClick" HorizontalAlignment="Left"/>
      <TextBlock x:Name="WindowsStartupStatus" Text="Open Arkade automatically when you sign in to Windows." Foreground="#A8B4C4" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
     <StackPanel x:Name="SecondaryScreenPanel" Margin="0,12,0,0" Visibility="Collapsed">
      <Button x:Name="SecondaryScreenButton" Content="SECOND SCREEN: AUTO" Click="CycleSecondaryScreen" HorizontalAlignment="Left"/>
      <TextBlock x:Name="SecondaryScreenStatus" Foreground="#A8B4C4" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
     <Border x:Name="MusicPanel" Background="#172131" CornerRadius="10" Padding="16" Margin="0,22,0,18" Visibility="Collapsed">
      <StackPanel><TextBlock Text="CABINET MUSIC" Foreground="#EAC574" FontSize="14" FontWeight="Bold"/>
       <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,7"/>
       <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#A8B4C4" Margin="0,0,0,12"/>
       <WrapPanel><Button x:Name="MusicPreviousButton" Content="PREVIOUS" Click="MusicPreviousClick" Padding="10,10" Margin="0,0,6,6"/><Button x:Name="MusicPlayButton" Content="{Binding PlayLabel}" Click="MusicPlayClick" Padding="16,10" Margin="0,0,6,6"/><Button x:Name="MusicNextButton" Content="NEXT" Click="MusicNextClick" Padding="12,10" Margin="0,0,6,6"/></WrapPanel>
       <WrapPanel><Button x:Name="MusicFolderButton" Content="CHOOSE FOLDER" Click="MusicFolderClick" Padding="10,10" Margin="0,0,6,6"/><Button x:Name="MusicQuieterButton" Content="VOL −" Click="MusicQuieterClick" Padding="10,10" Margin="0,0,6,6"/><Button x:Name="MusicLouderButton" Content="VOL +" Click="MusicLouderClick" Padding="10,10" Margin="0,0,6,6"/></WrapPanel>
       <Button x:Name="MusicAnimationButton" Content="{Binding AnimationLabel}" Click="MusicAnimationClick" HorizontalAlignment="Left" Margin="0,5,0,3" Padding="10,10"/>
       <TextBlock Text="MEDIA PLAY/PAUSE · NEXT/PREVIOUS TRACK&#10;F6 PLAY/PAUSE · F7 NEXT · F8 PREVIOUS" TextWrapping="Wrap" FontSize="10" Foreground="#A8B4C4" Margin="0,7,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel></ScrollViewer>
    <Button x:Name="UtilityBackButton" Grid.Row="1" Content="BACK TO LIBRARY" Click="CloseUtility" HorizontalAlignment="Left"/>
   </Grid>
  </Border>
  <Border x:Name="PowerOverlay" Background="#FC101722" BorderBrush="#EAC574" BorderThickness="1" CornerRadius="15" Margin="22,16" Padding="28" Visibility="Collapsed" Panel.ZIndex="95">
   <StackPanel VerticalAlignment="Center" MaxWidth="480">
    <TextBlock Text="CABINET POWER" FontSize="28" FontWeight="Black" Foreground="#EAC574"/>
    <TextBlock x:Name="PowerMessage" Text="Choose what you would like the computer to do." FontSize="16" TextWrapping="Wrap" Margin="0,18,0,24"/>
    <StackPanel x:Name="PowerChoices"><Button x:Name="PowerOffButton" Content="POWER OFF COMPUTER" Click="ChoosePowerOff" Margin="0,0,0,12"/><Button x:Name="PowerSleepButton" Content="SLEEP" Click="ChooseSleep" Margin="0,0,0,12"/><Button x:Name="PowerRestartButton" Content="RESTART COMPUTER" Click="ChooseRestart" Margin="0,0,0,12"/></StackPanel>
    <Button x:Name="PowerConfirmButton" Content="CONFIRM" Click="ConfirmPower" Visibility="Collapsed" Background="#EAC574" Foreground="#17150F" Margin="0,0,0,12"/>
    <Button x:Name="PowerCancelButton" Content="BACK TO ARKADE" Click="CancelPower"/>
    <TextBlock Text="JOYSTICK  CHOOSE     SELECT  CONFIRM     BACK  CANCEL" Foreground="#A8B4C4" FontSize="10" TextWrapping="Wrap" Margin="0,18,0,0"/>
   </StackPanel>
  </Border>
  <Border x:Name="UpdateOverlay" Background="#FC101722" BorderBrush="#EAC574" BorderThickness="1" CornerRadius="15" Margin="22,16" Padding="28" Visibility="Collapsed" Panel.ZIndex="99">
   <Grid MaxWidth="640"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="UpdateTitle" Text="ARKADE UPDATE" FontSize="25" FontWeight="Black" Foreground="#EAC574" TextWrapping="Wrap"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,20"><TextBlock x:Name="UpdateMessage" TextWrapping="Wrap" FontSize="16"/></ScrollViewer>
    <StackPanel Grid.Row="2"><ProgressBar x:Name="UpdateProgress" Height="9" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,18"/>
     <Button x:Name="UpdateInstallButton" Content="DOWNLOAD AND INSTALL" Click="InstallUpdateClick" Background="#EAC574" Foreground="#17150F" Margin="0,0,0,12"/>
     <Button x:Name="UpdateLaterButton" Content="LATER" Click="CloseUpdate"/>
     <TextBlock Text="JOYSTICK  CHOOSE     SELECT / START  CONFIRM     BACK  CANCEL" Foreground="#A8B4C4" FontSize="10" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <controls:NowPlayingWidget x:Name="NowPlayingDisplay" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,22,0" Panel.ZIndex="90"/>
  <Grid x:Name="LaunchSplash" Background="#090D15" Panel.ZIndex="200" Visibility="Collapsed" AutomationProperties.Name="Starting selected game">
   <Image Source="{Binding SelectedGame.ArtworkPath}" Stretch="UniformToFill" Opacity="0.08"/>
   <Image Source="Assets/Arkade-logo.png" Width="190" Height="60" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" AutomationProperties.Name="Arkade logo"/>
   <Viewbox Stretch="Uniform" MaxWidth="600" Margin="38,90">
    <StackPanel Width="460">
     <Grid Height="260" Margin="0,0,0,28"><TextBlock Text="{Binding SelectedGame.Symbol}" FontSize="100" Foreground="#EAC574" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding SelectedGame.ArtworkPath}" Stretch="Uniform"/></Grid>
     <TextBlock Text="NOW LAUNCHING" Foreground="#EAC574" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
     <TextBlock Text="{Binding SelectedGame.Title}" FontSize="34" FontWeight="Black" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,10"/>
     <TextBlock Text="{Binding SelectedGame.Platform}" Foreground="#B7C4D6" FontSize="14" HorizontalAlignment="Center"/>
     <ProgressBar IsIndeterminate="True" Height="3" Foreground="#EAC574" Background="#293141" BorderThickness="0" Margin="45,30,45,18"/>
     <TextBlock x:Name="LaunchStatusText" Foreground="#B7C4D6" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
   </Viewbox>
   <TextBlock Text="GET READY TO PLAY" Foreground="#EAC574" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,35"/>
  </Grid>
  <Grid x:Name="StartupSplash" Background="Black" Panel.ZIndex="100" AutomationProperties.Name="Arkade intro video">
   <MediaElement x:Name="SplashVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" Volume="0.65" IsHitTestVisible="False" MediaOpened="OnSplashVideoOpened" MediaEnded="OnSplashVideoEnded" MediaFailed="OnSplashVideoFailed"/>
   <Border Background="#99000000" CornerRadius="8" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" IsHitTestVisible="False"><TextBlock Text="PRESS SELECT TO SKIP" Foreground="#EAC574" FontSize="12"/></Border>
  </Grid>
 </Grid>
</Window>
